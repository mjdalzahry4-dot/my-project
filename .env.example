# Copy these placeholders into your local environment or PythonAnywhere WSGI environment.
# Generate a unique DJANGO_SECRET_KEY in the secret store; never commit its real value.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=mjdkhaled1.pythonanywhere.com
DJANGO_DEBUG=false

# Public HTTPS frontend and API origins, comma-separated; no path or trailing slash.
# Local origins are enabled by the development settings only.
CORS_ORIGINS=https://mjdkhaled1.pythonanywhere.com,https://incandescent-stardust-31fbdc.netlify.app
# Legacy alias; prefer CORS_ORIGINS.
CORS_ALLOWED_ORIGINS=

# Use the PostgreSQL host, port, database, username, and password from PythonAnywhere.
# URL-encode special characters in the password. Keep this value private.
DATABASE_URL=postgresql://PA_DB_USER:REPLACE_WITH_SECRET@PA_POSTGRES_HOST:PA_POSTGRES_PORT/PA_DATABASE_NAME
DATABASE_SSLMODE=verify-full
# Optional only if your database provider supplies a separate CA file:
DATABASE_SSLROOTCERT=

# PythonAnywhere supplies the WSGI host and HTTPS handling.
PORT=8000
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# This project is Django/Python; NODE_ENV and JWT_SECRET are not used.
# Browser API login uses expiring DRF tokens; CORS must allow the Authorization header.
