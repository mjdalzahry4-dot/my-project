# Copy these placeholders into your local environment or Render service settings.
# Generate a unique DJANGO_SECRET_KEY in the secret store; never commit its real value.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DJANGO_DEBUG=false

# Exact HTTPS origin(s), comma-separated. For GitHub Pages use
# https://YOUR_GITHUB_USERNAME.github.io (without a path or trailing slash).
CORS_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io
# Legacy alias; prefer CORS_ORIGINS.
CORS_ALLOWED_ORIGINS=

# Use the Render PostgreSQL internal connection URL. Keep credentials in Render's secret store.
DATABASE_URL=postgresql://USER:REPLACE_WITH_SECRET@HOST:5432/DB_NAME
DATABASE_SSLMODE=verify-full
# Optional only if your database provider supplies a separate CA file:
DATABASE_SSLROOTCERT=

# Render sets PORT automatically; 10000 is its conventional default.
PORT=10000
DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# This project is Django/Python; NODE_ENV and JWT_SECRET are not used.
