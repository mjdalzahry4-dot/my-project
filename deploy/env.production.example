# Copy these values into the process secret store; this file contains placeholders only.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=REPLACE_WITH_A_GENERATED_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=mjdkhaled1.pythonanywhere.com
CORS_ORIGINS=https://mjdkhaled1.pythonanywhere.com,https://incandescent-stardust-31fbdc.netlify.app
# Browser clients send Authorization: Token <key>; only list trusted HTTPS origins.
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# Use the PostgreSQL connection details from PythonAnywhere. Keep the real password private.
DATABASE_URL=postgresql://PA_DB_USER:REPLACE_OUTSIDE_THIS_FILE@PA_POSTGRES_HOST:PA_POSTGRES_PORT/PA_DATABASE_NAME
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=

# Configure this in the process environment for backup/restore commands only.
PGPASSFILE=/secure/path/to/pgpass.conf
