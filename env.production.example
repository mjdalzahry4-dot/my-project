# Copy these values into the process secret store; this file contains placeholders only.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=REPLACE_WITH_A_GENERATED_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=api.example.edu
CORS_ALLOWED_ORIGINS=https://app.example.edu
DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# Use the provider's verified PostgreSQL hostname and database CA certificate.
DATABASE_URL=postgresql://gpms_user:REPLACE_OUTSIDE_THIS_FILE@db.example.edu:5432/gpms
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=/path/to/provider-postgres-ca.pem

# Configure this in the process environment for backup/restore commands only.
PGPASSFILE=/secure/path/to/pgpass.conf
